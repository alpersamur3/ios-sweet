diff --git a/iokit/Kernel/arm/SweetAppleSurface.cpp b/iokit/Kernel/arm/SweetAppleSurface.cpp
new file mode 100755
index 0000000..e83f5e1
--- /dev/null
+++ b/iokit/Kernel/arm/SweetAppleSurface.cpp
@@ -0,0 +1,228 @@
+/*
+ * Kernel-side access to Apple's IOSurface kext (see SweetAppleSurface.h).
+ *
+ * AppleCLCD (SweetFramebuffer.cpp) needs three things from the surface root:
+ * the pixels behind a surface id (a swap names surfaces by id), a surface
+ * for GetLayerDefaultSurface, and a send right to that surface in the
+ * caller's task. The kext does all three; this file calls its functions
+ * through the table the prelinker fills in. Without that table (a kernel
+ * that was not prelinked with the kext) every call fails cleanly.
+ *
+ * Look-ups are made on behalf of the task that owns the framebuffer user
+ * client (backboardd): the kext only hands a surface to a task whose client
+ * knows it, and backboardd created or looked up every surface it swaps.
+ *
+ * sweet_apple_surface_lookup() keeps a small cache of kernel mappings and is
+ * only called from AppleCLCD's work loop thread.
+ */
+#include "SweetAppleSurface.h"
+
+#if defined(SWEET) && SWEET_APPLE_IOSURFACE
+#include <IOKit/IOLib.h>
+#include <IOKit/IOService.h>
+#include <IOKit/IOBufferMemoryDescriptor.h>
+#include <libkern/c++/OSDictionary.h>
+#include <libkern/c++/OSNumber.h>
+#include <libkern/c++/OSObject.h>
+
+extern "C" {
+/* Not static: tools/prelink.py finds it by name in the kernel's symbol table. */
+struct sweet_isurf_hooks sweet_isurf_hooks __attribute__((used)) = {
+	SWEET_ISURF_MAGIC, kSweetISurfCount, 0, { NULL }
+};
+}
+
+typedef void *(*isurf_root_fn)(void);
+typedef void *(*isurf_lookup_fn)(void *root, uint32_t id, task_t task);
+typedef void *(*isurf_create_fn)(void *root, task_t task, OSDictionary *props);
+typedef int (*isurf_copyport_fn)(void *root, task_t task, void *surface, uint32_t *name);
+typedef void *(*isurf_memory_fn)(void *surface, void *service);
+typedef uint32_t (*isurf_get_fn)(void *surface);
+
+static inline void *
+sweet_isurf_hook(unsigned i)
+{
+	return ((void *volatile *)sweet_isurf_hooks.fn)[i];
+}
+
+static uint32_t
+sweet_isurf_get(unsigned i, void *surface)
+{
+	return ((isurf_get_fn)sweet_isurf_hook(i))(surface);
+}
+
+static void *
+sweet_isurf_root(void)
+{
+	return ((isurf_root_fn)sweet_isurf_hook(kSweetISurfRoot))();
+}
+
+bool
+sweet_apple_surface_ready(void)
+{
+	if (sweet_isurf_hooks.magic != SWEET_ISURF_MAGIC) {
+		return false;
+	}
+	for (unsigned i = 0; i < kSweetISurfCount; i++) {
+		if (sweet_isurf_hook(i) == NULL) {
+			return false;
+		}
+	}
+	return sweet_isurf_root() != NULL;
+}
+
+#define SWEET_ISURF_ROOT_NAME   "IOCoreSurfaceRoot"
+
+void
+sweet_apple_surface_publish_name(void)
+{
+	static unsigned logged;
+
+	if (!sweet_apple_surface_ready()) {
+		return;
+	}
+	IOService *root = (IOService *)sweet_isurf_root();
+	if (strcmp(root->getName(), SWEET_ISURF_ROOT_NAME) != 0) {
+		root->setName(SWEET_ISURF_ROOT_NAME);
+		if (logged++ < 8) {
+			IOLog("SWEET FB: IOSurfaceRoot named %s\n", root->getName());
+		}
+	}
+}
+
+#define SWEET_ISURF_MAPS        8
+
+static struct {
+	IOMemoryDescriptor *md;         /* retained: the key must not be recycled */
+	IOMemoryMap        *map;
+} sweet_isurf_maps[SWEET_ISURF_MAPS];
+static unsigned sweet_isurf_map_next;
+
+/* Kernel address of the memory's first byte, or 0. */
+static uintptr_t
+sweet_isurf_map(IOMemoryDescriptor *md)
+{
+	IOBufferMemoryDescriptor *buffer = OSDynamicCast(IOBufferMemoryDescriptor, md);
+	if (buffer != NULL) {
+		return (uintptr_t)buffer->getBytesNoCopy();
+	}
+	for (unsigned i = 0; i < SWEET_ISURF_MAPS; i++) {
+		if (sweet_isurf_maps[i].md == md) {
+			return (uintptr_t)sweet_isurf_maps[i].map->getVirtualAddress();
+		}
+	}
+	IOMemoryMap *map = md->map(kIOMapDefaultCache);
+	if (map == NULL) {
+		return 0;
+	}
+	unsigned slot = sweet_isurf_map_next++ % SWEET_ISURF_MAPS;
+	OSSafeReleaseNULL(sweet_isurf_maps[slot].map);
+	OSSafeReleaseNULL(sweet_isurf_maps[slot].md);
+	md->retain();
+	sweet_isurf_maps[slot].md = md;
+	sweet_isurf_maps[slot].map = map;
+	return (uintptr_t)map->getVirtualAddress();
+}
+
+bool
+sweet_apple_surface_lookup(uint32_t id, task_t task, struct SweetAppleSurface *out)
+{
+	bzero(out, sizeof(*out));
+	if (!sweet_apple_surface_ready()) {
+		return false;
+	}
+	void *s = ((isurf_lookup_fn)sweet_isurf_hook(kSweetISurfLookup))(sweet_isurf_root(), id, task);
+	if (s == NULL) {
+		return false;
+	}
+	out->surface = s;
+	out->id = id;
+	out->width = sweet_isurf_get(kSweetISurfWidth, s);
+	out->height = sweet_isurf_get(kSweetISurfHeight, s);
+	out->bytesPerRow = sweet_isurf_get(kSweetISurfBytesPerRow, s);
+	out->bytesPerElement = sweet_isurf_get(kSweetISurfBytesPerElement, s) & 0xffff;
+	out->pixelFormat = sweet_isurf_get(kSweetISurfPixelFormat, s);
+	out->elementWidth = (uint8_t)sweet_isurf_get(kSweetISurfElementWidth, s);
+	out->elementHeight = (uint8_t)sweet_isurf_get(kSweetISurfElementHeight, s);
+	out->baseOffset = sweet_isurf_get(kSweetISurfBaseOffset, s);
+	out->allocOffset = sweet_isurf_get(kSweetISurfAllocOffset, s);
+	out->allocSize = sweet_isurf_get(kSweetISurfAllocSize, s);
+	out->planes = sweet_isurf_get(kSweetISurfPlanes, s);
+	out->memory = (IOMemoryDescriptor *)((isurf_memory_fn)sweet_isurf_hook(kSweetISurfMemory))(s, NULL);
+	if (out->memory != NULL) {
+		uint64_t skip = (uint64_t)out->allocOffset + out->baseOffset;
+		uint64_t len = out->memory->getLength();
+		uintptr_t base = sweet_isurf_map(out->memory);
+		out->length = len > skip ? len - skip : 0;
+		out->pixels = (base != 0 && len > skip) ? base + (uintptr_t)skip : 0;
+	}
+	return true;
+}
+
+void
+sweet_apple_surface_put(struct SweetAppleSurface *s)
+{
+	if (s->surface != NULL) {
+		((OSObject *)s->surface)->release();
+		s->surface = NULL;
+	}
+}
+
+static void
+sweet_isurf_dict_u32(OSDictionary *dict, const char *key, uint32_t value)
+{
+	OSNumber *n = OSNumber::withNumber(value, 32);
+	if (n != NULL) {
+		dict->setObject(key, n);
+		n->release();
+	}
+}
+
+bool
+sweet_apple_surface_create_port(task_t task, uint32_t width, uint32_t height,
+    uint32_t pixelFormat, uint32_t *portName, uint32_t *surfaceID)
+{
+	if (!sweet_apple_surface_ready()) {
+		return false;
+	}
+	void *root = sweet_isurf_root();
+	uint32_t bpr = (width * 4 + 63) & ~63u;
+	OSDictionary *props = OSDictionary::withCapacity(8);
+	if (props == NULL) {
+		return false;
+	}
+	sweet_isurf_dict_u32(props, "IOSurfaceWidth", width);
+	sweet_isurf_dict_u32(props, "IOSurfaceHeight", height);
+	sweet_isurf_dict_u32(props, "IOSurfaceBytesPerElement", 4);
+	sweet_isurf_dict_u32(props, "IOSurfaceElementWidth", 1);
+	sweet_isurf_dict_u32(props, "IOSurfaceElementHeight", 1);
+	sweet_isurf_dict_u32(props, "IOSurfacePixelFormat", pixelFormat);
+	sweet_isurf_dict_u32(props, "IOSurfaceBytesPerRow", bpr);
+	sweet_isurf_dict_u32(props, "IOSurfaceAllocSize", (uint32_t)round_page((uint64_t)bpr * height));
+	void *s = ((isurf_create_fn)sweet_isurf_hook(kSweetISurfCreate))(root, task, props);
+	props->release();
+	if (s == NULL) {
+		IOLog("SWEET FB: IOSurfaceRoot::createSurface(%ux%u) failed\n", width, height);
+		return false;
+	}
+	uint32_t name = 0;
+	int ret = ((isurf_copyport_fn)sweet_isurf_hook(kSweetISurfCopyPort))(root, task, s, &name);
+	*surfaceID = sweet_isurf_get(kSweetISurfID, s);
+	/*
+	 * Drop our reference only when something else (the send right) holds
+	 * the surface too: whether createSurface hands back an owned reference
+	 * was not read off the kext, and a leak of one surface is the safe side.
+	 */
+	int rc = ((OSObject *)s)->getRetainCount();
+	IOLog("SWEET FB: default surface %u created, retain count %d, port 0x%x -> 0x%x\n",
+	    *surfaceID, rc, name, ret);
+	if (rc > 1) {
+		((OSObject *)s)->release();
+	}
+	if (ret != 0 || name == 0) {
+		return false;
+	}
+	*portName = name;
+	return true;
+}
+#endif /* SWEET && SWEET_APPLE_IOSURFACE */
diff --git a/iokit/Kernel/arm/SweetAppleSurface.h b/iokit/Kernel/arm/SweetAppleSurface.h
new file mode 100755
index 0000000..b9b4412
--- /dev/null
+++ b/iokit/Kernel/arm/SweetAppleSurface.h
@@ -0,0 +1,90 @@
+/*
+ * Kernel-side access to Apple's IOSurface kext (SWEET_APPLE_IOSURFACE 1).
+ *
+ * The kext is prelinked into the kernel image after the kernel was linked,
+ * so the kernel cannot name its functions. tools/prelink.py (--hooks) writes
+ * their addresses into sweet_isurf_hooks.fn[] in the image instead, in the
+ * order of the enum below (it checks magic and count first). Every entry is
+ * a plain C++ member function of the kext's IOSurfaceRoot / IOSurface,
+ * called with `this` as the first argument (Itanium arm64 ABI).
+ *
+ * The kext functions, by index:
+ *   kSweetISurfRoot       IOSurfaceRoot::root()
+ *   kSweetISurfLookup     IOSurfaceRoot::lookupSurface(unsigned, task*)      retained
+ *   kSweetISurfCreate     IOSurfaceRoot::createSurface(task*, OSDictionary*) retained
+ *   kSweetISurfCopyPort   IOSurfaceRoot::copyPortNameForSurfaceInTask(task*, IOSurface*, unsigned*)
+ *   kSweetISurfMemory     IOSurface::getMemoryDescriptor(IOService*)
+ *   kSweetISurfID .. kSweetISurfPlanes   IOSurface::get*() const
+ */
+#ifndef _SWEET_APPLE_SURFACE_H
+#define _SWEET_APPLE_SURFACE_H
+
+#include "SweetSurfaceMode.h"
+#include <pexpert/arm64/board_config.h>
+
+#if defined(SWEET) && SWEET_APPLE_IOSURFACE
+#include <IOKit/IOMemoryDescriptor.h>
+#include <mach/mach_types.h>
+
+enum {
+	kSweetISurfRoot,
+	kSweetISurfLookup,
+	kSweetISurfCreate,
+	kSweetISurfCopyPort,
+	kSweetISurfMemory,
+	kSweetISurfID,
+	kSweetISurfWidth,
+	kSweetISurfHeight,
+	kSweetISurfBytesPerRow,
+	kSweetISurfPixelFormat,
+	kSweetISurfBytesPerElement,
+	kSweetISurfElementWidth,
+	kSweetISurfElementHeight,
+	kSweetISurfBaseOffset,
+	kSweetISurfAllocOffset,
+	kSweetISurfAllocSize,
+	kSweetISurfPlanes,
+	kSweetISurfCount
+};
+
+#define SWEET_ISURF_MAGIC       0x53575f4953524600ULL   /* "SW_ISRF\0" */
+
+struct sweet_isurf_hooks {
+	uint64_t magic;
+	uint32_t count;
+	uint32_t bound;                 /* set by the prelinker once fn[] is filled */
+	void    *fn[kSweetISurfCount];
+};
+
+/* A surface as the display driver reads it. Filled by sweet_apple_surface_lookup. */
+struct SweetAppleSurface {
+	void               *surface;    /* IOSurface*, retained; NULL when empty */
+	uint32_t            id, width, height, bytesPerRow, bytesPerElement;
+	uint32_t            baseOffset, allocOffset, allocSize, planes, pixelFormat;
+	uint8_t             elementWidth, elementHeight;
+	IOMemoryDescriptor *memory;     /* owned by the surface */
+	uint64_t            length;     /* memory->getLength() */
+	uintptr_t           pixels;     /* kernel address of the first pixel, 0 if unmapped */
+};
+
+/* The kext is bound (prelinked) and its root service is up. */
+bool sweet_apple_surface_ready(void);
+
+/*
+ * Name the kext's IOSurfaceRoot "IOCoreSurfaceRoot", the name iOS 16's
+ * IOSurface.framework looks it up by (IOServiceNameMatching). The kext ends
+ * IOSurfaceRoot::start with setName("IOSurfaceRoot"), so this is called from
+ * AppleCLCD's vsync tick and sets the name again whenever it is not right.
+ */
+void sweet_apple_surface_publish_name(void);
+
+/* Retained look-up of a surface id on behalf of `task` (the task whose client created it). */
+bool sweet_apple_surface_lookup(uint32_t id, task_t task, struct SweetAppleSurface *out);
+void sweet_apple_surface_put(struct SweetAppleSurface *s);
+
+/* A fresh BGRA surface owned by `task` and a send right to it in `task`. */
+bool sweet_apple_surface_create_port(task_t task, uint32_t width, uint32_t height,
+    uint32_t pixelFormat, uint32_t *portName, uint32_t *surfaceID);
+
+#endif /* SWEET && SWEET_APPLE_IOSURFACE */
+#endif /* _SWEET_APPLE_SURFACE_H */
