+/*
+ * Build switch for SWEET's IOSurface root.
+ *
+ * SWEET_APPLE_IOSURFACE 0 (default): the kernel carries its own IOSurface
+ * root (SweetSurface.cpp, "IOCoreSurfaceRoot") and the display driver
+ * (SweetFramebuffer.cpp, AppleCLCD) reads the surfaces from it.
+ *
+ * SWEET_APPLE_IOSURFACE 1: SweetSurface is left out. The iOS userland talks
+ * to Apple's own IOSurface kext (macOS 13.5, IOSurface 336.60.1, prelinked
+ * into the kernel image by tools/prelink.py), registered under the name
+ * "IOCoreSurfaceRoot". AppleCLCD stays in the kernel and reaches the kext
+ * through SweetAppleSurface.cpp (a table of kext functions the prelinker
+ * fills in). xnu/patches-opt/ holds the patch that sets this to 1; the xnu
+ * workflow applies it with the apple_iosurface input.
+ */
+#ifndef _SWEET_SURFACE_MODE_H
+#define _SWEET_SURFACE_MODE_H
+
+#define SWEET_APPLE_IOSURFACE 0
+
+#endif /* _SWEET_SURFACE_MODE_H */
